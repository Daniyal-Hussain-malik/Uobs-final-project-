# ================================================================
# OASIS Resort Skardu - Backend Environment Configuration Example
# Copy this file to '.env' and fill in your actual production/staging values.
# ================================================================

# Server Settings
PORT=5000
NODE_ENV=development

# MySQL Database Configuration (XAMPP / Hostinger MySQL / Cloud DB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=oasis_resort
DB_CONNECTION_LIMIT=10

# Authentication & Security
JWT_SECRET=oasis_resort_skardu_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# Allowed Frontend URL(s) for CORS (supports comma-separated list or '*')
FRONTEND_URL=http://localhost:5173

# Optional Custom Uploads Directory (Leave commented or empty to default to backend/uploads)
# UPLOAD_DIR=/home/u123456789/domains/oasisresort.pk/public_html/uploads

# Default Seed User Credentials (Used on initial database seed only)
DEFAULT_ADMIN_EMAIL=admin@oasisresort.pk
DEFAULT_ADMIN_PASSWORD=password123
DEFAULT_ADMIN_PHONE=+92 300 1234567
