# ================================================================
# OASIS Resort Skardu - Root Environment Configuration Example
# Copy this file to '.env' or refer to backend/.env.example & frontend/.env.example
# ================================================================

# --- BACKEND SETTINGS ---
PORT=5000
NODE_ENV=production

# MySQL Database (Hostinger / XAMPP / Cloud DB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=oasis_resort
DB_CONNECTION_LIMIT=10

# Security & CORS
JWT_SECRET=oasis_resort_skardu_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# Optional Custom Uploads Directory
# UPLOAD_DIR=/path/to/custom/uploads

# Default Admin Credentials for DB initial seeding
DEFAULT_ADMIN_EMAIL=admin@oasisresort.pk
DEFAULT_ADMIN_PASSWORD=password123
DEFAULT_ADMIN_PHONE=+92 300 1234567

# --- FRONTEND SETTINGS (VITE_*) ---
# Set these when building the frontend
VITE_API_URL=http://localhost:5000
VITE_RESORT_NAME=OASIS Resort
VITE_RESORT_PHONE=0308-1472888
VITE_RESORT_PHONE_SECONDARY=0344-5537788
VITE_RESORT_EMAIL=oasisresortskardu@gmail.com
VITE_RESORT_WHATSAPP=923081472888
