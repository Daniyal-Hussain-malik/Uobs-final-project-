# ================================================================
# OASIS Resort Skardu - Frontend Environment Configuration Example
# Copy this file to '.env' or set these variables in your hosting provider
# ================================================================

# Backend API Endpoint
# - For separate frontend hosting (Vercel, Netlify): Set full backend URL (e.g., https://api.oasisresort.pk)
# - For single-domain Hostinger / monolith Node.js deployment: Leave blank or set '/api'
VITE_API_URL=http://localhost:5000

# Local Vite Dev Server Settings
VITE_PORT=5173
VITE_DEV_BACKEND_URL=http://localhost:5000

# Resort Brand & Contact Info
VITE_RESORT_NAME=OASIS Resort
VITE_RESORT_SUBTITLE=Cold Desert • Katpana Dunes • Gilgit-Baltistan
VITE_RESORT_ADDRESS=Katpana Cold Desert, Skardu, Gilgit-Baltistan 16100, Pakistan
VITE_AIRPORT_DISTANCE=15 Minutes (11 km) from Skardu International Airport
VITE_RESORT_ALTITUDE=2,228m Alt

# Contact Phone Numbers & WhatsApp
VITE_RESORT_PHONE=0308-1472888
VITE_RESORT_PHONE_SECONDARY=0344-5537788
VITE_RESORT_PHONE_CONCIERGE=+92 344 8603636
VITE_RESORT_PHONE_RAW=+923081472888
VITE_RESORT_WHATSAPP=923081472888

# Email Addresses
VITE_RESORT_EMAIL=oasisresortskardu@gmail.com
VITE_RESORT_EMAIL_BILLING=info@oasisresortskardu.com

# Check-in / Check-out Times
VITE_CHECK_IN_TIME=14:00 PM
VITE_CHECK_OUT_TIME=11:30 AM

# Social Media Links
VITE_FACEBOOK_URL=https://www.facebook.com/OasissResorts/
VITE_INSTAGRAM_URL=https://www.instagram.com/oasis_resort_skardu/?
VITE_TIKTOK_URL=https://www.tiktok.com/@oasis_res0rt

# Currency
VITE_CURRENCY=PKR
